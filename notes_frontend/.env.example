# PUBLIC_INTERFACE
# Environment variables required by the notes_frontend app.
# Copy this file to `.env` and set the values appropriately.

# Secret used to sign the session cookie. REQUIRED for production.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: Base URL of a backend API for notes (if you later integrate with a service).
# Currently the app stores notes in localStorage; this can be used in future integration.
VITE_API_BASE_URL=""
